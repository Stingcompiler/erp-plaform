# --- Python / Django (backend) ---
__pycache__/
*.pyc
*.sqlite3
backend/staticfiles/
backend/media/
backend/.env
.venv/
.venv*/
venv/
*.sqlite3.*

# --- Node / Next.js (frontend) ---
frontend/node_modules
frontend/node_modules/
# .next/ is the intermediate build cache (~170 MB) and is never served.
frontend/.next/
# The dev server's own cache (next.config.js), so a build never clobbers it.
frontend/.next-dev/
# frontend/out/ is deliberately NOT ignored. Django serves it straight from
# disk in the monolithic setup (backend/core/frontend.py), so committing it
# lets the app be deployed from a clone without a Node toolchain. It is ~2 MB.
#
# The cost: it can go stale. Editing anything under frontend/ without running
# `npm run build` leaves a commit whose served UI does not match its own
# source. Always rebuild before committing frontend changes.
frontend/.env.local

# --- General ---
.DS_Store
*.log

# --- Standalone release build (deploy/standalone/package_release.sh) ---
# Written into the tree at packaging time and shipped inside the archive.
/release-manifest.json
/SHA256SUMS

# Playwright output (frontend/e2e)
frontend/playwright-report/
frontend/test-results/
