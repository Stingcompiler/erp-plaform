# Copy to .env for local dev. On Render, these are injected as real env
# vars per render.yaml — never commit an actual .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to `not DEBUG`. To test the monolithic static-frontend-serving path
# (DEBUG=False, core/frontend.py) locally over plain HTTP — no TLS terminator
# in front like Render has — set this to False too. Leave unset in prod.
# FORCE_HTTPS=False

# Local dev default is SQLite (see config/settings.py) — leave unset locally.
# On Render this is auto-populated from the erp-db managed Postgres instance.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Next.js dev server origin, for CORS + credentialed cookie auth.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth cookie (JWT via HttpOnly cookie) ---
# Leave unset locally. In prod, set the domain the cookie is scoped to.
# AUTH_COOKIE_DOMAIN=.onrender.com
# 'Lax' works for same-site frontend/api; use 'None' only if cross-site
# (which then also forces Secure). Default is Lax.
AUTH_COOKIE_SAMESITE=Lax

# Local dev default assumes Redis running on localhost (e.g. via system
# package or a locally-run redis-server — no Docker per PROJECT_RULES).
# On Render this is auto-populated from the erp-cache managed instance.
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Optional: durable backup object storage (S3/R2-compatible) ---
# Set BACKUP_S3_BUCKET to enable off-box backup payload storage. Leave blank
# for metadata-only backups. boto3 is only imported when this is configured.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
