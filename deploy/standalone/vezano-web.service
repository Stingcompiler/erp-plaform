[Unit]
Description=Vezano ERP web service
After=network.target postgresql.service

[Service]
Type=simple
User=vezano
Group=vezano
WorkingDirectory=/opt/vezano/current/backend
EnvironmentFile=/etc/vezano/vezano.env
ExecStart=/opt/vezano/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
