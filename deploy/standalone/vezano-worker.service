[Unit]
Description=Vezano ERP background worker
# Optional: only needed when CELERY_BROKER_URL points at a running Redis.
After=network.target redis-server.service

[Service]
Type=simple
User=vezano
Group=vezano
WorkingDirectory=/opt/vezano/current/backend
Environment=VEZANO_ENV_FILE=/etc/vezano/vezano.env
ExecStart=/opt/vezano/current/venv/bin/celery -A config worker --loglevel=INFO
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
