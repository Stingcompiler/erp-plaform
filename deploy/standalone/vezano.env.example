# /etc/vezano/vezano.env — mode 0600, owned by the vezano user.
# Read by Django (django-environ): KEY=VALUE, one per line, no shell syntax.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
# True behind the TLS proxy (Caddy/nginx); only False for a plain-HTTP test.
FORCE_HTTPS=True
DJANGO_ALLOWED_HOSTS=vezano.example.com
DATABASE_URL=postgres://vezano:replace-me@127.0.0.1:5432/vezano
MEDIA_ROOT=/var/lib/vezano/media
# Only used by vezano-worker.service; the web service runs without Redis.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
VEZANO_DEPLOYMENT_MODE=standalone
SUBSCRIPTION_POLICY=enforce
# Directory holding the vendor's licence public key(s): <key-id>.public.pem.
VEZANO_LICENSE_PUBLIC_KEYS_DIR=/etc/vezano/license-keys
CORS_ALLOWED_ORIGINS=https://vezano.example.com
