# Loaded automatically by `next build` (production mode). The monolithic
# build serves the frontend and API from the same origin (see
# backend/core/frontend.py), so this must stay a relative path — never an
# absolute host — or it'll break under a different hostname (127.0.0.1 vs
# localhost vs the real domain are different origins to the browser).
NEXT_PUBLIC_API_BASE_URL=/api
