# Copy to .env.local for local dev — never commit an actual .env.local file.

# Local dev: Django runs on :8000 via `manage.py runserver`.
# On Render: set this to the erp-api service's internal/external URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Public URL of the isolated Vezano trial instance shown to visitors.
NEXT_PUBLIC_DEMO_URL=https://demo.example.com/
