{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev_server.js",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "e2e",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/e2e_server.js",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "numberone-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "../../mobileOne/numberOnePlatform/frontend"
      ],
      "port": 5173
    },
    {
      "name": "e2e-enforce",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/e2e_server.js",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000,
      "env": {
        "SUBSCRIPTION_POLICY": "enforce"
      }
    }
  ]
}
